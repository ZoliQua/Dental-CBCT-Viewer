{
  "name": "dental-cbct-viewer",
  "version": "1.2.0",
  "description": "Embeddable dental CBCT/CT DICOM viewer for React — MPR + true-3D views, panoramic (OPG) reconstruction along the dental arch, perpendicular cross-sections, guided implant planning with safety clearances and bone quality, and a printable drill-guide (STL) export.",
  "type": "module",
  "license": "MIT",
  "author": "Zoltán Dul",
  "homepage": "https://dental-cbct-viewer.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoliQua/Dental-CBCT-Viewer.git"
  },
  "bugs": {
    "url": "https://github.com/ZoliQua/Dental-CBCT-Viewer/issues"
  },
  "keywords": [
    "dental",
    "cbct",
    "dicom",
    "implant",
    "implant-planning",
    "guided-surgery",
    "drill-guide",
    "viewer",
    "react",
    "cornerstone3d",
    "mpr",
    "panoramic",
    "opg",
    "cross-section",
    "3d",
    "volume-rendering",
    "medical-imaging",
    "dentistry",
    "oral-surgery"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "lang",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:lib",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "@cornerstonejs/core": "^2.0.0",
    "@cornerstonejs/dicom-image-loader": "^2.0.0",
    "@cornerstonejs/tools": "^2.0.0",
    "@kitware/vtk.js": "^32.9.0",
    "dicom-parser": "^1.8.21",
    "jspdf": "^4.2.1",
    "manifold-3d": "^3.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.8"
  }
}
